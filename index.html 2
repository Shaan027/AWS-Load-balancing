<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Project 2 - Amazon Style</title>
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      font-family: Arial, sans-serif;
    }

    /* Header Navbar */
    header {
      background-color: #131921;
      color: white;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 10px 20px;
      height: 60px;
    }

    .nav-logo h2 {
      color: #febd69;
      font-size: 24px;
      font-weight: bold;
    }

    .nav-search {
      display: flex;
      flex: 1;
      max-width: 600px;
      margin: 0 20px;
    }

    .nav-search input {
      width: 100%;
      padding: 10px;
      border: none;
      border-radius: 4px 0 0 4px;
      font-size: 15px;
      outline: none;
    }

    .search-btn {
      background-color: #febd69;
      border: none;
      padding: 0 15px;
      border-radius: 0 4px 4px 0;
      cursor: pointer;
      font-size: 16px;
    }

    .nav-right {
      display: flex;
      align-items: center;
      gap: 20px;
      font-size: 14px;
    }

    /* Sub Navigation Bar */
    .sub-nav {
      background-color: #232f3e;
      color: white;
      display: flex;
      padding: 10px 20px;
      gap: 20px;
      font-size: 14px;
      align-items: center;
    }

    /* Hero / Banner Section */
    .hero {
      background: linear-gradient(to bottom, rgba(0,0,0,0.1), rgba(0,0,0,0.6)), url('https://images.unsplash.com/photo-1607083206869-4c7672e72a8a?auto=format&fit=crop&w=1200&q=80') no-repeat center center/cover;
      height: 250px;
      display: flex;
      align-items: center;
      justify-content: center;
      text-align: center;
      color: red;
      padding: 20px;
    }

    .hero h1 {
      font-size: 3rem;
      font-weight: bold;
      color: red;
      text-shadow: 2px 2px 6px rgba(0,0,0,0.8);
    }

    /* Product Grid Section */
    .shop-section {
      max-width: 1200px;
      margin: -60px auto 20px auto;
      padding: 0 20px;
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      gap: 20px;
      position: relative;
      z-index: 10;
    }

    .box {
      background-color: white;
      padding: 20px;
      border-radius: 4px;
      box-shadow: 0 4px 10px rgba(0,0,0,0.1);
    }

    .box h3 {
      font-size: 18px;
      margin-bottom: 15px;
      color: #0f1111;
    }

    .box-content img {
      width: 100%;
      height: 200px;
      object-fit: cover;
      margin-bottom: 10px;
      border-radius: 4px;
    }

    .box-content a {
      color: #007185;
      text-decoration: none;
      font-size: 13px;
    }
  </style>
</head>
<body>

  <!-- Header -->
  <header>
    <div class="nav-logo">
      <h2>amazon.in</h2>
    </div>
    <div class="nav-search">
      <input type="text" placeholder="Search Amazon.in">
      <button class="search-btn">🔍</button>
    </div>
    <div class="nav-right">
      <div>Hello, Sign in</div>
      <div>Cart 🛒</div>
    </div>
  </header>

  <!-- Sub Navbar -->
  <div class="sub-nav">
    <span>☰ All</span>
    <span>Fresh</span>
    <span>Amazon Pay</span>
    <span>Gift Cards</span>
    <span>Sell</span>
    <span>Customer Service</span>
  </div>

  <!-- Hero Section with RED Project 2 Heading -->
  <div class="hero">
    <h1>This is project 2</h1>
  </div>

  <!-- Product Cards Grid -->
  <div class="shop-section">
    <div class="box">
      <h3>Starting ₹199 | Electronics</h3>
      <div class="box-content">
        <img src="https://images.unsplash.com/photo-1505740420928-5e560c06d30e?auto=format&fit=crop&w=400&q=80" alt="Electronics">
        <a href="#">See all offers</a>
      </div>
    </div>

    <div class="box">
      <h3>Automotive essentials</h3>
      <div class="box-content">
        <img src="https://images.unsplash.com/photo-1503376780353-7e6692767b70?auto=format&fit=crop&w=400&q=80" alt="Car parts">
        <a href="#">See more</a>
      </div>
    </div>
  </div>

</body>
</html>
